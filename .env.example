# Required: your Anthropic API key (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional: max AI requests per learner per day, to cap your API bill (0 = unlimited)
# AI_DAILY_LIMIT=200

# Optional: secret for signing login cookies (otherwise generated and stored in the database)
# SESSION_SECRET=

# Optional: where the SQLite database lives (default ./data)
# DATA_DIR=./data
